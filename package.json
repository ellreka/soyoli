{
  "name": "soyoli",
  "version": "0.0.4",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "APP_VARIANT=development expo start",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=development expo run:ios",
    "web": "expo start --web",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "licenses:update": "node scripts/licenses.mjs",
    "licenses:native": "node scripts/native-licenses.mjs"
  },
  "dependencies": {
    "@expo/material-symbols": "0.1.1",
    "@expo/ui": "58.0.27",
    "@react-native-community/slider": "5.2.1",
    "expo": "58.0.23",
    "expo-asset": "58.0.20",
    "expo-audio": "58.0.11",
    "expo-clipboard": "58.0.4",
    "expo-constants": "58.0.15",
    "expo-dev-client": "58.0.19",
    "expo-device": "58.0.5",
    "expo-file-system": "58.0.13",
    "expo-font": "58.0.11",
    "expo-glass-effect": "58.0.5",
    "expo-image": "58.0.18",
    "expo-keep-awake": "58.0.3",
    "expo-linking": "58.0.16",
    "expo-media-control": "2.1.0",
    "expo-router": "58.0.30",
    "expo-speech": "58.0.3",
    "expo-splash-screen": "58.0.13",
    "expo-status-bar": "58.0.4",
    "expo-symbols": "58.0.4",
    "expo-system-ui": "58.0.7",
    "expo-updates": "58.0.21",
    "expo-web-browser": "58.0.7",
    "fast-xml-parser": "5.12.0",
    "fflate": "0.8.3",
    "htmlparser2": "12.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.1",
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "oxfmt": "0.78.0",
    "oxlint": "1.91.0",
    "oxlint-config-universe": "0.2.0",
    "oxlint-tsgolint": "7.0.2006",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  },
  "jest": {
    "moduleNameMapper": {
      "\\.xml$": "<rootDir>/__mocks__/xmlAsset.js",
      "(^|/)(IconButton|ListSwitch|NativeButton|NativeRow|NativeTextField|NativeSelect|NativeSlider|NativeSwitch|SelectionMark)$": "<rootDir>/src/components/$2.tsx"
    },
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|htmlparser2|domhandler|domutils|domelementtype|dom-serializer|entities))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@11.25.0",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-speech"
        ]
      }
    }
  }
}

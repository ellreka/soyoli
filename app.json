{
  "expo": {
    "name": "Soyoli",
    "slug": "soyoli",
    "version": "0.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "soyoli",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      },
      "bundleIdentifier": "com.ellreka.soyoli"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF8F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ellreka.soyoli",
      "runtimeVersion": {
        "policy": "appVersion"
      },
      "permissions": ["android.permission.MODIFY_AUDIO_SETTINGS"]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF8F1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#2A2D33",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-asset",
      [
        "expo-media-control",
        {
          "enableBackgroundAudio": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "641266bf-aded-4d33-a0b1-9392b8950abb"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/641266bf-aded-4d33-a0b1-9392b8950abb"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "ellreka"
  }
}
